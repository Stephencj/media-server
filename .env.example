# Media Server Environment Configuration
# Copy this to .env and fill in your values

# JWT Secret - REQUIRED
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here

# Webhook Secret (for auto-deploy)
# Generate with: openssl rand -hex 16
WEBHOOK_SECRET=your-webhook-secret-here

# Path to your media files
# On Pop!_OS, USB drives mount to /media/username/DriveName
# Create a symlink: sudo ln -s /media/username/YourDrive /mnt/media
MEDIA_PATH=/mnt/media

# TMDb API Key (optional, for movie/show metadata)
# Get one free at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Server port (default 8080)
# MEDIA_SERVER_PORT=8080

# Device API keys for per-platform auto-auth (iOS / tvOS / Fire TV).
# Format: "label1=sha256hash1,label2=sha256hash2,..."
# These are SHA-256 hashes of the plaintext keys; the plaintext lives only
# in each app's gitignored Secrets file. Idempotent on every server boot.
MEDIA_SERVER_DEVICE_KEYS=ios=PUTHASHHERE,tvos=PUTHASHHERE,firetv=PUTHASHHERE
